# .gitignore - project root
# Node modules (backend & frontend) and any other node_modules
/apps/backend/node_modules/
/apps/frontend/node_modules/
node_modules/

# Build artefacts
/dist/
/coverage/
/.next/
out/

# Frontend specific ignores
apps/frontend/.next/
apps/frontend/AGENTS.md

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp

# Environment files (do not commit credentials)
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
